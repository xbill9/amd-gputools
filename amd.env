# amd-gputools configuration — the source of truth for this project.
#
# Committed on purpose, and deliberately not gitignored: everything in here is
# an identifier, never a secret. The API token is NOT here. It lives in `.env`
# (gitignored, mode 0600) or in the environment.
#
# A real environment variable always wins over this file: python-dotenv does
# not overwrite, and the Makefile uses `?=`.

# Every droplet lookup is filtered by this tag, so the MCP server can only see
# droplets somebody tagged for this project. Tag the MI300 droplet with this in
# the DigitalOcean console, or change this to the tag it already carries.
DROPLET_TAG=gemma

# SSH into the droplet. DigitalOcean's GPU images land you as root by default.
SSH_USER=root
SSH_PORT=22
# Path to the private key, if it is not one ssh finds by itself. `~` is expanded.
SSH_KEY=~/amd

# Where the project checkout lives on the droplet.
REMOTE_WORKDIR=/opt/amd-gputools

# The MCP client's key for this server. It prefixes every tool name
# (mcp__amd-gputools__list_droplets), so it must match the directory name or
# two loaded servers become indistinguishable at the call site.
MCP_SERVER_NAME=amd-gputools

# vLLM. Both the docker and the bare-metal path read these.
#
# The model is ungated on purpose: a gated one (every Gemma repo, Llama) turns a
# first run into an HF login problem instead of a vLLM problem. Set HF_TOKEN in
# .env and change this once the path itself is known to work.
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_PORT=8000
# Image tag for the docker path. gfx94X-dcgpu is the MI300-series build; the
# `cdna` tags are the same family but twice the size, and the gfx110X/gfx120X
# tags are RDNA and will not run here.
VLLM_IMAGE=rocm/vllm:rocm7.13.0_gfx94X-dcgpu_ubuntu24.04_py3.13_pytorch_2.10.0_vllm_0.19.1
# Where model weights are cached on the droplet. Mounted into the container so a
# re-pull or a container restart does not re-download 15 GB of weights.
HF_CACHE=/opt/hf-cache

# amd-gputools configuration — the source of truth for this project.
#
# Committed on purpose, and deliberately not gitignored: everything in here is
# an identifier, never a secret. The API token is NOT here. It lives in `.env`
# (gitignored, mode 0600) or in the environment.
#
# A real environment variable always wins over this file: python-dotenv does
# not overwrite, and the Makefile uses `?=`.

# Every droplet lookup is filtered by this tag, so the MCP server can only see
# droplets somebody tagged for this project. Tag the MI300 droplet with this in
# the DigitalOcean console, or change this to the tag it already carries.
DROPLET_TAG=gemma

# SSH into the droplet. DigitalOcean's GPU images land you as root by default.
SSH_USER=root
SSH_PORT=22
# Path to the private key, if it is not one ssh finds by itself. `~` is expanded.
SSH_KEY=~/amd

# Where the project checkout lives on the droplet.
REMOTE_WORKDIR=/opt/amd-gputools

# The MCP client's key for this server. It prefixes every tool name
# (mcp__amd-gputools__list_droplets), so it must match the directory name or
# two loaded servers become indistinguishable at the call site.
MCP_SERVER_NAME=amd-gputools

# vLLM. Both the docker and the bare-metal path read these.
#
# The model is ungated on purpose: a gated one (Llama, and every Gemma repo
# before Gemma 4) turns a first run into an HF login problem instead of a vLLM
# problem. google/gemma-4-E2B-it is Apache-2.0 and ungated, so it keeps that
# property while actually being the thing this box is for. It is the
# effective-2B member of the family — there is no `gemma-4-2B`; the lineup is
# E2B, E4B, 12B, 26B-A4B, 31B.
VLLM_MODEL=google/gemma-4-E2B-it
VLLM_PORT=8000

# Image tag for the docker path. A CONTAINER NIGHTLY, ON PURPOSE — and with
# Gemma 4, NEWER IS NOT SAFER.
#
# rocm/vllm:rocm10.0.0_..._vllm_0.27.0 is the newest image AMD publishes and it
# CANNOT LOAD THIS MODEL: no Gemma4ModelArchConfigConvertor, so config parsing
# raises AmbiguousGlobalPerLayerAttributeError on `head_dim` before the GPU is
# touched. Gemma 4 runs 256-wide heads on its sliding-attention layers and 512
# on its full-attention ones; transformers >= 5.15 reports that as a per-layer
# attribute and raises on a global read, and vLLM's `getattr(..., 0)` default
# cannot catch it. The previous default here,
# rocm/vllm:rocm7.13.0_gfx94X-dcgpu_..._vllm_0.19.1, does serve Gemma 4 — from
# the other side, since transformers 5.8.1 predates per-layer attributes
# entirely — so the broken build sits BETWEEN the two that work.
#
# The pip channel vLLM's own Gemma 4 recipe names,
# wheels.vllm.ai/rocm/nightly/rocm721, is staler than all three at 0.20.2rc1.
#
# For AMD's own tags the architecture suffix still matters: gfx94X-dcgpu is the
# MI300-series build, `cdna` is the same family at twice the size, and
# gfx110X/gfx120X are RDNA and will not run here. The vllm/vllm-openai-rocm
# images are not arch-tagged and carry gfx942 in the same build.
#
# devto-gemma4-mi300x-vllm.md has the full comparison.
VLLM_IMAGE=vllm/vllm-openai-rocm:nightly-rocm100
# Pin to a build instead, if daily drift matters:
#VLLM_IMAGE=vllm/vllm-openai-rocm:nightly-rocm100-af1c01499b289be555c475669ba50a88e96d846e

# Serving shape for the Gemma 4 path. The checkpoint supports 131072 and this
# card would hold it; 32768 is a workload choice. Measured at this setting:
# 9,026,017 tokens of KV cache, 275.45x concurrency.
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90

# audio is 0 because NO ROCm vLLM image ships the vllm[audio] extras — librosa
# and soundfile are absent from every one tried — so E2B's conformer audio
# encoder is unreachable whatever this says. 0 also skips allocating encoder
# memory for a path that cannot be used. Audio needs a derived image, not a flag.
LIMIT_MM_PER_PROMPT={"image": 4, "audio": 0}

# Ships inside the image; no mount needed.
CHAT_TEMPLATE=/app/vllm/examples/tool_chat_template_gemma4.jinja
# Where model weights are cached on the droplet. Mounted into the container so a
# re-pull or a container restart does not re-download 15 GB of weights.
HF_CACHE=/opt/hf-cache
